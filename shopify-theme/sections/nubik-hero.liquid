<section class="vhero" aria-label="Portada">
  <div class="vhero__media" aria-hidden="true">
    <video class="vhero__video is-on" data-src="{{ 'portada-pelota.mp4' | asset_url }}" data-src-sm="{{ 'portada-pelota-sm.mp4' | asset_url }}" poster="{{ 'portada-pelota.jpg' | asset_url }}" muted playsinline preload="auto"></video>
    <video class="vhero__video" data-src="{{ 'portada-guante.mp4' | asset_url }}" data-src-sm="{{ 'portada-guante-sm.mp4' | asset_url }}" poster="{{ 'portada-guante.jpg' | asset_url }}" muted playsinline preload="none"></video>
  </div>
  <div class="vhero__shade" aria-hidden="true"></div>
  <div class="wrap vhero__copy">
    <span class="vhero__eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="vhero__title">{{ section.settings.title_1 }}<br><span>{{ section.settings.title_2 }}</span></h1>
    <p class="vhero__lead">{{ section.settings.lead }}</p>
    <div class="btn-row vhero__btns">
      <a class="btn btn--nube" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}products/{{ settings.combo_handle }}">Ver el combo</a>
      <a class="btn btn--ghost-light" href="#te-suena">¿Te pasa esto?</a>
    </div>
    <div class="vhero__feats"><span>Se mueve sola</span><span>3 modos</span><span>Cargador incluido</span><span>Envíos a toda Colombia</span></div>
  </div>
  <div class="vhero__dots" role="group" aria-label="Videos de portada">
    <button type="button" data-vid="0" aria-label="Ver video: pelota interactiva rodando con un gato" aria-pressed="true"></button>
    <button type="button" data-vid="1" aria-label="Ver video: gato cepillado con el guante quitapelos" aria-pressed="false"></button>
  </div>
</section>

{% schema %}
{
  "name": "Portada con video",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Lema", "default": "Para quienes aman a su gato" },
    { "type": "text", "id": "title_1", "label": "Título (línea blanca)", "default": "Llegas cansado." },
    { "type": "text", "id": "title_2", "label": "Título (línea azul)", "default": "Él quiere jugar." },
    { "type": "textarea", "id": "lead", "label": "Texto", "default": "Sabemos lo que se siente cuando el día no alcanza para todo. La pelota NUBIK se mueve sola para que tu gato tenga con qué jugar, y tú, un poco menos de culpa." }
  ],
  "presets": [{ "name": "Portada con video" }]
}
{% endschema %}
