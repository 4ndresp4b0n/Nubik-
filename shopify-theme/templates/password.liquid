<section class="section center"><div class="wrap">
  <p><img src="{{ 'nubik-gato.png' | asset_url }}" alt="" width="120" height="86" style="margin:0 auto"></p>
  <h1 class="h2">NUBIK abre muy pronto</h1>
  <p class="lead" style="margin-inline:auto">Suave como una nube, feliz como un gato.</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="field" style="max-width:320px;margin:0 auto"><label for="pw">Contraseña de la tienda</label><input id="pw" type="password" name="password"></div>
    <button class="btn" type="submit" style="margin-top:12px">Entrar</button>
  {%- endform -%}
</div></section>
